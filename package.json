{
  "name": "gufan-downloader",
  "version": "0.1.0",
  "private": true,
  "description": "GuFan Windows desktop downloader for authorized Bilibili videos and audio.",
  "author": "GuFan",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeye9272ada/GFbiliDownload.git"
  },
  "bugs": {
    "url": "https://github.com/zeye9272ada/GFbiliDownload/issues"
  },
  "homepage": "https://github.com/zeye9272ada/GFbiliDownload#readme",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://127.0.0.1:5173 electron .\"",
    "icons": "node scripts/generate-icons.cjs",
    "build": "vite build",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.0",
    "cross-env": "^10.0.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.0.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.gufan.downloader",
    "productName": "孤帆下载器",
    "copyright": "Copyright © 2026 GuFan",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/app-icon.ico",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "app-icon.ico",
          "app-icon.png"
        ]
      }
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
